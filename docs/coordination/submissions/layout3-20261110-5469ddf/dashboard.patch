new file mode 100644
index 0000000..7bea4b9
--- /dev/null
+++ b/site/layout3.css
@@ -0,0 +1,42 @@
+/* Approved Layout 3: navigation / revealed-notice rail / working canvas. */
+:root{--rail:104px;--attention:220px;line-height:1.55}
+body{background:radial-gradient(ellipse at 75% 20%,#09202d 0,transparent 55%),var(--midnight)}
+header{margin-left:calc(var(--rail) + var(--attention));padding:28px 30px 24px;gap:8px 20px;min-height:132px;background:#030c12}
+header h1{font-size:32px;flex:1 1 55%}header p{margin:0;order:3;flex:1 1 50%;font-size:15px}header .badge{display:none}
+header .queue-badge{order:4;font-size:12px;min-height:36px;border-color:var(--orange);color:#ffad94;background:#231a17;padding:8px 12px}
+main{max-width:none;margin:0 0 0 calc(var(--rail) + var(--attention));display:block;padding:24px 30px 40px}
+main>nav{position:fixed;inset:0 auto 0 0;width:var(--rail);z-index:5;margin:0;padding:22px 0;background:#06121a;border-right:1px solid #1b303d;gap:4px;flex-wrap:nowrap;overflow-y:auto}
+.rail-brand{padding:0 6px 30px;text-align:center;display:block;text-decoration:none;color:#e5f2fa}.rail-brand svg{width:46px;margin:0 auto 7px;fill:none;stroke:#c5d7e1;stroke-width:2}.rail-brand strong{font-size:12px;letter-spacing:-.04em}
+main>nav button{display:flex;flex-direction:column;align-items:center;gap:7px;text-align:center;padding:15px 5px;border-radius:0;min-height:80px;font-size:12px;border:0;border-left:4px solid transparent;box-shadow:none}
+main>nav button[aria-pressed=true]{border-color:var(--blue);background:#07334b;color:#e6f7ff;box-shadow:none}.nav-icon{font-size:25px;line-height:1;color:#8db5ce}main>nav button[aria-pressed=true] .nav-icon{color:#09b5ff}
+.rail-github{display:block;text-align:center;font-size:12px;margin-top:auto;padding:24px 8px}
+#attentionRail{position:fixed;top:0;bottom:0;left:var(--rail);width:var(--attention);padding:42px 16px 24px;background:linear-gradient(150deg,#06151f,#040d13);border-right:1px solid #1b303d;overflow-y:auto}
+#attentionRail h2{font-size:22px;margin:0 0 22px}#attentionRail input,#attentionRail select{width:100%;font-size:12px;padding:9px;margin-bottom:8px}
+.rail-context{font-size:11px;color:var(--muted);margin:12px 0}.rail-notice{display:flex;flex-direction:column;gap:7px;width:100%;text-align:left;padding:14px 10px;background:transparent;border:0;border-top:1px solid #18303d;border-radius:0}
+.rail-notice:first-child{border:1px solid #174e6a;border-left:4px solid var(--blue);background:#092536;border-radius:5px}.rail-notice strong{font-size:13px}.rail-notice span{font-size:11px;color:#a8c5d6}.rail-notice small{font-size:10px;color:#ffae92}.rail-notice .review-tag{border:1px solid #b25d41;border-radius:16px;color:#ffae92;padding:2px 8px;align-self:flex-start;font-size:10px}
+.text-action{border-color:transparent;background:transparent;color:#8dd5fc;font-size:13px;padding-left:0;padding-right:0}.rail-footnote{font-size:11px;color:#8eacbf;margin-top:16px}
+.visually-hidden{position:absolute;clip-path:inset(50%);width:1px;height:1px;overflow:hidden;white-space:nowrap}
